{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "nodejs18.x",
      "config": {
        "includeFiles": ["server.js", "seed.js", "index.html", "css/**", "js/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
